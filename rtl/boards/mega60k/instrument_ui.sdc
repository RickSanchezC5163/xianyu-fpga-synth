create_clock -name sys_clk -period 20.000 [get_ports {sys_clk}]
# Legacy asynchronous board controls and physical USB receiver inputs.
set_false_path -from [get_ports {rst_n key0_n key1_n uart_rx usb_dp usb_dm}]
create_generated_clock -name usb_clk -source [get_ports {sys_clk}] -master_clock sys_clk -divide_by 5 -multiply_by 6 [get_pins {audio/direct_usb.pll/PLLA_inst/CLKOUT0}]
# Existing held-data/toggle CDC is verified separately, not by synchronous STA.
set_false_path -from [get_clocks {usb_clk}] -to [get_clocks {sys_clk}]
# New external inputs only enter first-stage synchronizer D pins. Explicit
# endpoint names avoid hiding all downstream UI timing. Check STA constraint
# application and synthesized fanout before accepting a run.
set_false_path -from [get_ports {lcd_miso}] -to [get_pins {audio/lcd_miso_meta_s0/D}]
set_false_path -from [get_ports {touch_irq_n}] -to [get_pins {audio/visual/pixel_display/touch/irq_meta_s0/D}]
# No multicycle / false-path exemptions inside the new UI. SPI is generated by
# clock enables in the 50 MHz domain. Outputs have the same 20 ns internal path
# budget; this does not certify an unpurchased module's external setup/hold.
set_output_delay -clock sys_clk -max 0.000 [get_ports {hp_bck hp_ws hp_din ext_mclk ext_bck ext_lrclk ext_din uart_tx lcd_sck lcd_mosi lcd_cs_n lcd_dc lcd_reset_n touch_cs_n debug_control debug_pcm rgb_din}]
set_output_delay -clock sys_clk -min 0.000 [get_ports {hp_bck hp_ws hp_din ext_mclk ext_bck ext_lrclk ext_din uart_tx lcd_sck lcd_mosi lcd_cs_n lcd_dc lcd_reset_n touch_cs_n debug_control debug_pcm rgb_din}]
set_false_path -to [get_ports {status_led* pa_en}]
