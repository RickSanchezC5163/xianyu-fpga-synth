// Sipeed tang_mega_60K_pins.cst + NEO 60K 31004 schematic.
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "key0_n" AA13;
IO_PORT "key0_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "key1_n" AB13;
IO_PORT "key1_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// NEO Dock revision 31004 routes its built-in USB-UART bridge to V14/U15.
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// USB-A2, SW4 in FPGA position: complete direct USB-MIDI host enabled.
IO_LOC "usb_dp" H13;
IO_PORT "usb_dp" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "usb_dm" G13;
IO_PORT "usb_dm" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "hp_bck" Y17;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_ws" AB17;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_din" AA16;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD1 IO0..3: optional external standard-I2S DAC (3.3 V logic).
IO_LOC "ext_mclk" Y21;
IO_PORT "ext_mclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ext_bck" Y22;
IO_PORT "ext_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ext_lrclk" AB21;
IO_PORT "ext_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ext_din" AB22;
IO_PORT "ext_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "rgb_din" J16;
IO_PORT "rgb_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[0]" P19;
IO_PORT "status_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "status_led[1]" R19;
IO_PORT "status_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// LOCAL BUILD CANDIDATE ONLY. NEO Dock Rev1.4 (2025-03-31), schematic
// pages5/6: SOM pin mapping; page19: PMOD connectors J9/J8.
// Do not connect DVP camera / SDRAM1 expansion on the shared pins.
// Does not alter the legacy audio.cst or reserve PMOD1 IO0..3 twice.
// PMOD0_IO2 J9.9
IO_LOC "lcd_sck" T21;
IO_PORT "lcd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD0_IO3 J9.10
IO_LOC "lcd_mosi" U21;
IO_PORT "lcd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD0_IO4 J9.7
IO_LOC "lcd_cs_n" P16;
IO_PORT "lcd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD0_IO5 J9.8
IO_LOC "lcd_dc" R17;
IO_PORT "lcd_dc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD0_IO6 J9.5
IO_LOC "lcd_reset_n" R18;
IO_PORT "lcd_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD0_IO7 J9.6
IO_LOC "touch_cs_n" T18;
IO_PORT "touch_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD1_IO4 J8.7
IO_LOC "touch_irq_n" AA20;
IO_PORT "touch_irq_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// PMOD1_IO5 J8.8
IO_LOC "lcd_miso" AA21;
IO_PORT "lcd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// PMOD1_IO6 J8.5
IO_LOC "debug_control" AA19;
IO_PORT "debug_control" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// PMOD1_IO7 J8.6
IO_LOC "debug_pcm" AB20;
IO_PORT "debug_pcm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
